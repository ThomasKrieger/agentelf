@prefix generate:  <http://agentelf.org/generate#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# The Ontology for generating Java Classes
#################################################################

<http://agentelf.org/generate>
    rdf:type owl:Ontology ;
    rdfs:label "The Ontology to generate Classes" .

#################################################################
# Classes
#################################################################

generate:NamedElement
    rdf:type owl:Class .

generate:FullQualifiedElement
    rdf:type owl:Class .

generate:WithDeclaration
    rdf:type owl:Class .

generate:WithDocumentation
    rdf:type owl:Class .

generate:TypeDeclaration
    rdf:type owl:Class ;
    rdfs:subClassOf generate:NamedElement;
    rdfs:label "Type Declarations" .

generate:Generate
    rdf:type owl:Class ;
    rdfs:subClassOf generate:TypeDeclaration,
                    generate:WithDocumentation;
    rdfs:label "Either an interface or class to be generated" .

generate:JavaClass
    rdf:type owl:Class ;
    rdfs:subClassOf generate:Generate;
    rdfs:label "A Class to be generated" .

generate:JavaInterface
    rdf:type owl:Class ;
    rdfs:subClassOf generate:Generate;
    rdfs:label "An Interface to be generated" .

generate:PrimitiveType
    rdf:type owl:Class ;
    rdfs:subClassOf generate:TypeDeclaration;
    rdfs:label "A primitive type like int. Classes inside java.lang are also treated as primitive types" .

generate:ExternalClass
    rdf:type owl:Class ;
    rdfs:subClassOf generate:TypeDeclaration,
                    generate:FullQualifiedElement;
    rdfs:label "An external Class" .

generate:ExternalGenericClass
    rdf:type owl:Class ;
    rdfs:subClassOf generate:TypeDeclaration,
                    generate:FullQualifiedElement;
    rdfs:label "An external generic Class" .

generate:JavaField
    rdf:type owl:Class ;
    rdfs:subClassOf generate:NamedElement,
                    generate:WithDeclaration,
                    generate:WithDocumentation;
    rdfs:label "Field" .

generate:JavaMethod
    rdf:type owl:Class ;
    rdfs:subClassOf generate:NamedElement,
                    generate:WithDeclaration,
                    generate:WithDocumentation;
    rdfs:label "Method" .

#################################################################
# Properties
#################################################################

generate:name
    rdf:type owl:DatatypeProperty ;
    rdfs:domain generate:NamedElement ;
    rdfs:range xsd:string .

generate:package
    rdf:type owl:ObjectProperty ;
    rdfs:domain generate:FullQualifiedElement ;
    rdfs:range xsd:string .

generate:documentation
    rdf:type owl:ObjectProperty ;
    rdfs:domain generate:WithDocumentation ;
    rdfs:range xsd:string .

generate:declaration
    rdf:type owl:ObjectProperty ;
    rdfs:domain generate:WithDeclaration ;
    rdfs:range xsd:string .

#################################################################
# Relations
#################################################################

generate:hasField
    rdf:type owl:ObjectProperty ;
    rdfs:domain generate:JavaClass ;
    rdfs:range generate:JavaField .

generate:hasMethod
    rdf:type owl:ObjectProperty ;
    rdfs:domain generate:Generate ;
    rdfs:range generate:JavaMethod .

generate:extendsClass
    rdf:type owl:ObjectProperty ;
    rdfs:domain generate:JavaClass ;
    rdfs:range generate:JavaClass .

generate:extendsInterface
    rdf:type owl:ObjectProperty ;
    rdfs:domain generate:Interface ;
    rdfs:range generate:Interface .

generate:implementsInterface
    rdf:type owl:ObjectProperty ;
    rdfs:domain generate:JavaClass ;
    rdfs:range generate:Interface .