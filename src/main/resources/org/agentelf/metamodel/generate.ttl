@prefix generate:  <http://agentelf.org/generate#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# The Ontology for generating Java Classes
#################################################################

<http://agentelf.org/generate>
    rdf:type owl:Ontology ;
    rdfs:label "The Ontology to generate Classes" .

#################################################################
# Classes
#################################################################

generate:NamedElement
    rdf:type owl:Class .

generate:WithDocumentation
    rdf:type owl:Class .

generate:WithDeclaration
    rdf:type owl:Class .

generate:ExternalOrJavaClass
     rdf:type owl:Class .

generate:JavaType
    rdf:type owl:Class ;
    rdfs:subClassOf  generate:NamedElement,
                     generate:ExternalOrJavaClass,
                     generate:WithDocumentation;
    rdfs:label "A Class, interface  to be generated" .


generate:ExternalType
    rdf:type owl:Class ;
    rdfs:subClassOf generate:WithDeclaration,
                    generate:ExternalOrJavaClass;
    rdfs:label "An external Class" .

generate:JavaField
    rdf:type owl:Class ;
    rdfs:subClassOf generate:WithDeclaration;
    rdfs:label "Field" .

generate:JavaMethod
    rdf:type owl:Class ;
    rdfs:subClassOf generate:WithDeclaration;
    rdfs:label "Method" .


#################################################################
# Properties
#################################################################

generate:name
    rdf:type owl:DatatypeProperty ;
    rdfs:domain generate:NamedElement ;
    rdfs:range xsd:string .

generate:documentation
    rdf:type owl:ObjectProperty ;
    rdfs:domain generate:WithDocumentation ;
    rdfs:range xsd:string .

generate:declaration
    rdf:type owl:ObjectProperty ;
    rdfs:domain generate:WithDeclaration ;
    rdfs:range xsd:string .

generate:type
    rdf:type owl:ObjectProperty ;
    rdfs:domain generate:JavaType ;
    rdfs:range xsd:string ;
    rdfs:label "The type of the class for example class or interface" .

#################################################################
# Relations
#################################################################

generate:hasField
    rdf:type owl:ObjectProperty ;
    rdfs:domain generate:JavaType ;
    rdfs:range generate:JavaField .

generate:hasMethod
    rdf:type owl:ObjectProperty ;
    rdfs:domain generate:JavaType ;
    rdfs:range generate:JavaMethod .

generate:extends
    rdf:type owl:ObjectProperty ;
    rdfs:domain generate:JavaType ;
    rdfs:range generate:ExternalOrJavaClass .

generate:uses
    rdf:type owl:ObjectProperty ;
    rdfs:domain generate:JavaType ;
    rdfs:range generate:ExternalOrJavaClass .
